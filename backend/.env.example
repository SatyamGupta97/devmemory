# Copy to .env and fill in real values. Never commit .env.
# Embeddings. Leave empty to use the deterministic local provider, which needs
# no key and works offline but compares surface form rather than meaning.
# Setting both API_KEY and MODEL switches retrieval to a hosted model.
# auto | local | gemini | hosted
DEVMEMORY_EMBEDDING_PROVIDER=auto
# For real semantic retrieval (native Google API, no SDK):
# DEVMEMORY_EMBEDDING_PROVIDER=gemini
# DEVMEMORY_EMBEDDING_API_KEY=<google-ai-studio-key>
# DEVMEMORY_EMBEDDING_MODEL=gemini-embedding-2
# Similarity floor for meaning-capturing providers. 0.65 was measured for
# gemini-embedding-2; set 0 to rank everything without a cut-off.
# DEVMEMORY_SEMANTIC_FLOOR_MEANING=0.65
DEVMEMORY_EMBEDDING_API_KEY=
DEVMEMORY_EMBEDDING_MODEL=
# DEVMEMORY_EMBEDDING_BASE_URL=https://api.openai.com/v1

# AI-assisted analysis. Optional: without both of these the deterministic
# health check is the whole product, and the AI endpoint says so plainly.
# DEVMEMORY_LLM_API_KEY=
# DEVMEMORY_LLM_MODEL=
# DEVMEMORY_LLM_BASE_URL=https://api.openai.com/v1
# DEVMEMORY_LLM_MAX_MEMORIES=60
# Retries on a transient provider failure (429/5xx). Free tiers shed load often.
# DEVMEMORY_LLM_RETRIES=2
# DEVMEMORY_LLM_RETRY_BACKOFF=1.5

# Gemini's OpenAI-compatible endpoint, for reference:
# DEVMEMORY_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# DEVMEMORY_LLM_MODEL=gemini-3.5-flash

# Where the SQLite file lives. Defaults to backend/devmemory.db.
# DEVMEMORY_DB_PATH=

# Comma-separated browser origins allowed to call this API.
# Defaults to Vite's dev server. Add your deployed frontend here.
# DEVMEMORY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173